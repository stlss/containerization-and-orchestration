{
  "uid": "lab-api-red",
  "title": "Lab API — RED",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "lab2",
    "RED"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "to": "now",
    "from": "now-15m"
  },
  "panels": [
    {
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "min": 0,
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Интенсивность запросов",
      "description": "Количество завершённых запросов в секунду.",
      "gridPos": {
        "h": 8,
        "x": 0,
        "w": 24,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(lab_http_requests_total{job=\"lab-api\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Интенсивность запросов"
        }
      ]
    },
    {
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "min": 0,
          "unit": "percentunit"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "Доля ошибок 5xx",
      "description": "Доля ошибок среди завершённых запросов. При отсутствии трафика значение не определено.",
      "gridPos": {
        "h": 8,
        "x": 0,
        "w": 24,
        "y": 8
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(lab_http_errors_total{job=\"lab-api\"}[$__rate_interval])) / sum(rate(lab_http_requests_total{job=\"lab-api\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Доля ошибок 5xx"
        }
      ]
    },
    {
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "min": 0,
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "type": "timeseries",
      "title": "p95 времени ответа",
      "description": "Оценка 95-го перцентиля длительности обработки запросов в секундах.",
      "gridPos": {
        "h": 8,
        "x": 0,
        "w": 24,
        "y": 16
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lab_http_request_duration_seconds_bucket{job=\"lab-api\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p95 времени ответа"
        }
      ]
    }
  ]
}
